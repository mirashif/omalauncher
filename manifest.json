{
  "schemaVersion": 1,
  "id": "com.mirashif.omalauncher",
  "name": "Omalauncher",
  "version": "1.0.0",
  "author": "Mir Ashif",
  "license": "MIT",
  "description": "A keyboard-first command palette for Omarchy.",
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Launcher.qml",
    "barWidget": "LauncherBar.qml"
  },
  "barWidget": {
    "displayName": "Omalauncher",
    "description": "Open the launcher or jump directly to its settings.",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
